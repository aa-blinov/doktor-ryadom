# Copy to .env on the server. Do not commit credentials.
RYADOM_SMTP_HOST=
RYADOM_SMTP_PORT=465
RYADOM_SMTP_SECURE=true
RYADOM_SMTP_USER=
RYADOM_SMTP_PASSWORD=
# Alternatively, configure Resend instead of SMTP.
RYADOM_RESEND_API_KEY=
RYADOM_MAIL_FROM=
RYADOM_VAPID_SUBJECT=https://doktor-ryadom.duckdns.org
